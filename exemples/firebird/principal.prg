&& Base Firebird : connexion, création de table, paramètres, transactions,
&& RETURNING, itérateur, BLOB texte, séquence.
&&
&&   wdlexisrt exemples/firebird/principal.prg [base] [utilisateur] [motdepasse]
&&
&& Il faut un serveur Firebird (https://www.firebirdsql.org) et la bibliothèque
&& cliente (libfbclient.so / libfbclient.dylib / fbclient.dll) : installée avec
&& le client Firebird, placée dans le dossier linOS (macOS, winOS) à côté de
&& l'exécutable ou du programme, ou indiquée par la variable WDLEXIS_FIREBIRD.
&& Adaptez les paramètres de connexion (arguments ou variables FB_BASE,
&& ISC_USER, ISC_PASSWORD).

si non firebird.disponible()
  ? "Bibliothèque cliente Firebird introuvable : voir l'en-tête de ce programme."
  systeme.quitter(1)
finsi
? "Client Firebird :", firebird.version()

locale base = systeme.args[1] ou systeme.env("FB_BASE") ou ;
              "localhost:" + fichier.joindre(fichier.dossiertemp(), "lexis_demo.fdb")
locale utilisateur = systeme.args[2] ou systeme.env("ISC_USER") ou "SYSDBA"
locale motdepasse = systeme.args[3] ou systeme.env("ISC_PASSWORD") ou "masterkey"

&& Connexion (la base est créée si elle n'existe pas encore).
locale db
essayer
  db = firebird.connecter(base, utilisateur, motdepasse)
capturer e
  ? "Connexion impossible (" + e + ") : création de", base
  db = firebird.creer(base, utilisateur, motdepasse)
finessayer
? "Serveur :", db:serveur()

&& Création de la table (une seule fois).
si non contient(db:tables(), "CLIENT")
  db:executer([[
    create table client (
      id integer generated by default as identity primary key,
      nom varchar(80) not null,
      ville varchar(60),
      credit numeric(12, 2) default 0,
      inscrit date,
      notes blob sub_type text)]])
finsi
db:executer("delete from client")

&& Paramètres « ? » : nombres, textes, dates ("AAAA-MM-JJ"), nul.
db:executer("insert into client(nom, ville, credit, inscrit) values (?, ?, ?, ?)", "Dupont", "Brest", 120.5, "2024-03-12")
db:executer("insert into client(nom, ville, credit, inscrit) values (?, ?, ?, ?)", {"Durand", "Nantes", 80, "2025-01-05"})
db:executer("insert into client(nom, ville) values (?, ?)", "Martin", nul)

&& INSERT ... RETURNING : la ligne renvoyée donne l'identifiant attribué.
locale r = db:premier("insert into client(nom, ville, notes) values (?, ?, ?) returning id", ;
                      "Leroy", "Rennes", "Client fidèle depuis 1998." + car(10) + "Préfère le courriel.")
? "Nouvel identifiant :", r.id

&& Transaction explicite : tout est validé, ou rien en cas d'erreur.
db:transaction(@AUGMENTER_CREDITS)
essayer
  db:transaction(@TRANSACTION_RATEE)
capturer e
  ? "Transaction annulée :", e
finessayer

&& Lecture : liste complète, première ligne, valeur, itérateur.
pour chaque c dans db:requete("select id, nom, ville, credit, inscrit from client where credit >= ? order by nom", 0)
  ? c.id, c.nom, c.ville ou "-", c.credit, c.inscrit ou "-"
suivant
? "Nombre de clients :", db:valeur("select count(*) from client")
? "Notes de Leroy :", db:valeur("select notes from client where nom = ?", "Leroy")
pour chaque c dans db:lignes("select nom from client order by nom")
  ?? c.nom, ""
suivant
?

&& Transaction manuelle.
db:debut()
db:executer("update client set ville = ? where ville is null", "Inconnue")
? "Lignes modifiées :", db:modifications()
db:annuler()
? "Après annulation :", db:valeur("select count(*) from client where ville = 'Inconnue'")

&& Colonnes d'une table.
pour chaque col dans db:colonnes("client")
  ? "  ", col.nom, col.type, col.longueur
suivant

db:fermer()

procedure AUGMENTER_CREDITS(db)
  db:executer("update client set credit = credit * 1.1 where credit > 0")
retourner

procedure TRANSACTION_RATEE(db)
  db:executer("update client set credit = 0")
  db:executer("insert into client(nom) values (?)", nul)      && nom obligatoire : erreur
retourner
